# Public Firebase Web App identifiers ONLY. Copy to .env.staging.local.
# Never paste an xAI secret, service-account JSON, private token or card info here.
# Enter the public Firebase apiKey locally from Project Settings -> Your apps.
VITE_FIREBASE_CONFIG='{"apiKey":"FIREBASE_PUBLIC_WEB_API_KEY","authDomain":"reflect-ai-staging.firebaseapp.com","projectId":"reflect-ai-staging","appId":"1:599679789981:web:d4d8743dbff0fe40af1d74","messagingSenderId":"599679789981"}'
VITE_APP_ID=reflect-8fdc8
VITE_USE_FIREBASE_EMULATORS=false

# Phase 1: initialize signed App Check on the staging Hosting site,
# but DO NOT expose the un-deployed AI callable to visitors yet.
VITE_ENABLE_STAGING_APP_CHECK=true
VITE_ENABLE_REFLECT_CLOUD_AI=false
VITE_AI_STAGING_PROJECT_ID=reflect-ai-staging

# This is the public reCAPTCHA Enterprise site key created for the exact
# staging Hosting domain, NOT the reCAPTCHA secret or the xAI API key.
VITE_APP_CHECK_SITE_KEY=PASTE_PUBLIC_RECAPTCHA_ENTERPRISE_SITE_KEY

# Stage04H Railway fallback. Remains OFF until a healthy isolated Railway
# service, Firebase Auth+signed App Check, private quota ledger and owner
# acceptance are verified. The URL is PUBLIC and contains NO credentials.
# Safe precheck: shows a one-shot attestation button without enabling AI send.
# Requires the exact Railway staging domain; never add a private key here.
VITE_ENABLE_REFLECT_RAILWAY_PRECHECK=false
VITE_ENABLE_REFLECT_RAILWAY_AI=false
VITE_REFLECT_RAILWAY_AI_ORIGIN=
